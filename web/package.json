{
  "name": "apophis-teamseatwatch-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "vite build --config vite.owner.config.ts && vite build --config vite.public.config.ts",
    "build:owner": "vite build --config vite.owner.config.ts",
    "build:public": "vite build --config vite.public.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tools/owner-auth-contract.test.mjs tools/child-materials-interaction.test.mjs tools/workspace-discovery.test.mjs tools/delivery-destination-contract.test.mjs tools/standby-child-batches-interaction.test.mjs tools/workspace-verification.test.mjs tools/workspace-connection.test.mjs tools/personal-probe-scope.test.mjs tools/operation-wizard.test.mjs tools/public-redeem.test.mjs",
    "lint": "eslint src",
    "generate:contracts": "node ../tools/generate.mjs --write",
    "check:contracts": "node ../tools/generate.mjs --check"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@tanstack/react-table": "9.2.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
